# Pooled runtime connection. Use a non-production database locally.
DATABASE_URL=postgres://user:password@localhost:5432/course_atlas

# Direct connection used only by controlled migration commands.
DATABASE_URL_UNPOOLED=postgres://user:password@localhost:5432/course_atlas

# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# Added when a private Vercel Blob store is linked. Vercel OIDC is also supported.
BLOB_READ_WRITE_TOKEN=

# Bootstrap only. Admins otherwise use students.admin_role through normal auth.
ADMIN_EMAILS=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
