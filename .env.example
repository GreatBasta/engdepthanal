# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/engdepthanal

# next-auth JWT signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# Added automatically when a private Vercel Blob store is linked.
BLOB_READ_WRITE_TOKEN=

# Comma-separated emails granted admin access via their student login.
# Leave empty to disable this path.
ADMIN_EMAILS=you@example.com

# Dedicated admin login at /admin/login (username + password). Set BOTH to
# enable it. Keep the real values only here / in your host's env — never in
# the repo. Change the password by updating ADMIN_PASSWORD (old sessions expire).
ADMIN_USERNAME=sina
ADMIN_PASSWORD=change-me
