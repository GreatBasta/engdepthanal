{
  "name": "engdepthanal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "curriculum:generate": "node scripts/generate-curriculum-catalog.mjs",
    "curriculum:validate": "node --import tsx scripts/validate-curriculum.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed:demo": "tsx src/lib/db/seed-demo.ts",
    "db:setup": "drizzle-kit migrate && tsx src/lib/db/seed.ts",
    "db:verify": "tsx src/lib/db/verify.ts",
    "aggregate": "tsx src/lib/aggregate-run.ts",
    "db:deploy": "tsx src/lib/db/deploy.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "drizzle-orm": "^0.44.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.25",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
